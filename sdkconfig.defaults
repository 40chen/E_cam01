# LCKFB-SZPI-ESP32-S3-VA board base configuration.
#
# NOTE: keep this file ASCII-only. IDF's kconfgen reads it with the platform
# default codec (GBK on a Chinese Windows), so non-ASCII comments break the build.
# Hardware parameters come from the vendor example 14-handheld, minus Bluetooth
# and the ESP-SR voice pipeline.

CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM: N16R8 is octal PSRAM, so OCT + 80MHz, flash in DIO ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
# 2026-09-25: 80M to 40M. The board started crashing in esp_psram_init at every
# boot, cold start included. The faulting PC is in IROM (code fetched from flash)
# and EXCVADDR is 0 -- a NULL dereference. If a flash read goes bad it comes back
# as zeros, and dereferencing that is exactly NULL; the PSRAM is not even mapped
# yet at that point. Lowering the clock is the cheapest mitigation for a marginal
# flash. Once it is stable, try 80M again to find out which side is marginal.
CONFIG_ESPTOOLPY_FLASHFREQ_40M=y

# ---- CPU / cache ----
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

# ---- FATFS: long filenames + Chinese codepage ----
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096

# ---- LVGL ----
# UI strings are English/icons for now; a CJK subset font is a later step.
CONFIG_LV_COLOR_16_SWAP=y
CONFIG_LV_MEM_CUSTOM=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y
CONFIG_LV_USE_PNG=y
# NOTE: no LVGL built-in CJK font is enabled on purpose. UI strings are English;
# the only Chinese text is file names on the music page, and those use the
# GB2312 subset font generated by tools/gen_cjk_font.py (see ui_theme.h's
# UI_FONT_CJK). LVGL's bundled simsun_16_cjk covers too few hanzi (1166) and was
# replaced by that subset.

# ---- App: startup orchestration needs more than the 3584 default ----
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
# SNTP: list several servers for redundancy (pool.ntp.org is often unreachable
# from mainland China). This value is also the capacity of
# esp_sntp_config_t.servers[], so it must be raised to list more than one.
# NOTE: keep this file ASCII-only -- kconfgen reads it with the platform's
# default codec (GBK here), and non-ASCII bytes make it fail to parse.
CONFIG_LWIP_SNTP_MAX_SERVERS=3

# ---- USB MSC (U-disk mode) ----
# The board has ONE Type-C behind a CH334F hub, feeding both the CH340K (-> UART0,
# which is our console and flash path) and the ESP32-S3 native USB (GPIO19/20).
# U-disk mode takes the native USB PHY for USB-OTG, so the USB-Serial-JTAG
# *secondary* console is turned off: it would only fight TinyUSB for that PHY,
# and logs keep going out on UART0 either way.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# U-disk mode is the USB Mass Storage Class device. 4KB transfers instead of the
# 512B default: measurably better throughput on a 1-bit SDMMC card.
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096

# NOTE: a vendor class (CONFIG_TINYUSB_VENDOR_COUNT) was briefly enabled here for
# the "USB Display" mode (device as a PC monitor). That mode was removed on
# 2026-09-26 because it needs a Windows IDD driver that would not start on the
# target machines; see _removed/README.md. Left at 0 on purpose.
